class Solution {
    public long maxAlternatingSum(int[] nums) {
       long sum=0;
    
        for(int i =0 ;i< nums.length;i++){ 
        nums[i]=nums[i]*nums[i];
        }
            Arrays.sort(nums);
       int half = nums.length/2;

       for(int i=0;i<nums.length;i++){
        if(i < half){
            sum-=nums[i];
        }else{
            sum+=nums[i];
        }
       }
        return sum;
    }
}

