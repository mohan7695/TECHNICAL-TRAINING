class Solution {
    public String kthDistinct(String[] arr, int k) {
        HashMap<String, Integer> map = new HashMap<>();

        for (String ch : arr) {
            map.put(ch, map.getOrDefault(ch, 0) + 1);
        }
        int count = 0;
        for (String ch : arr) {
            if (map.get(ch) == 1) {
                count++;
                if (count == k) {
                    return ch;
                }
            }

        }
        return "";
    }
}
