import java.util.*;
public class Main {
    public static void main(String[] args) {
        // Your code here
        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();

        long sum=0;
        PriorityQueue<Long> pq=new PriorityQueue<>();
        for(int i=0;i<n;i++){

            pq.add(sc.nextLong());
            
        }
        while(pq.size() > 1){
            long first=pq.poll();
            long sec=pq.poll();

            long k = first+sec;
            sum+=k;
            pq.add(k);
        }
System.out.println(sum);
    }
}
