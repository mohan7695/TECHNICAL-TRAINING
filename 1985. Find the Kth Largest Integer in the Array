import java.math.BigInteger;
class Solution {
    public String kthLargestNumber(String[] nums, int k) {
        PriorityQueue<String> pq = new PriorityQueue<>(
    (a, b) -> new BigInteger(b).compareTo(new BigInteger(a))
);
        for(String g  : nums) {

            pq.offer(g);
        }
        String p ="";
while( k != 0){
    p =pq.remove();
    k--;
}
        return p;
    }
}
