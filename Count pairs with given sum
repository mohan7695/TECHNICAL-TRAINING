class Solution {
    int countPairs(int arr[], int target) {
        // code here
        int count=0;
       Map<Integer,Integer> map =new HashMap<>();
        int n=arr.length;
       
        for(int i=0;i<n;i++){
           int d =target-arr[i] ;
           
           if(map.containsKey(d)){
             
             count+=map.get(d);
           }
           map.put(arr[i],map.getOrDefault(arr[i],0)+1);
        }
        return count;
    }
}
